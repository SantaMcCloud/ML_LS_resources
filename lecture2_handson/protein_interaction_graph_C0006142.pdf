    "\n",
    "graph_path = PATH_TO_GRAPHS + graph_name + '.gml'\n",
    "print('[+] Saving graph to path:', graph_path)\n",
    "nx.write_gml(G, graph_path)\n",
    "\n"
   ]
  },
