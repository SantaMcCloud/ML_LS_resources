   "source": [
    "### Calculating train weights\n",
    "\n",
    "We can see above that only a minority of classes is positive (P). This might create issues later on, since we do want to explain the positive classes. Hence we might want to set training weights. Choosing undersampling/oversampling instead comes with additional complications, since we want to train on the whole graph.\n",
    "\n",
    "![weights.png](attachment:11aa8ddd-85ac-421b-b840-25f99edfc9cb.png)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "72345dfe-b60c-4b78-87fe-9c71ff9ff31c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{0: 3.852924791086351, 1: 0.8018550724637681, 2: 0.8020875616120615, 3: 0.8020875616120615, 4: 1.0001446131597975}\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "def calculate_class_weights(labels):\n",
    "    unique_classes, class_counts = np.unique(labels, return_counts=True)\n",
    "    total_samples = len(labels)\n",
    "    class_weights = {cls: total_samples / (len(unique_classes) * count) for cls, count in zip(unique_classes, class_counts)}\n",
    "    return class_weights\n",
    "\n",
    "path_to_graph = PATH_TO_GRAPHS + 'feature_graph.gml'\n",
    "disease_id = 'C0006142'\n",
    "\n",
    "train_mask  = dataset[\"train_mask\"]\n",
    "labels_masked = labels[train_mask]\n",
    "weights = calculate_class_weights(labels_masked)\n",
    "print(weights)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "3dc1d862-82d0-4ab6-9c92-2689e2a02991",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "tensor([3.8529, 0.8019, 0.8021, 0.8021, 1.0001])"
      ]
     },
     "execution_count": 36,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "#  Find the highest index\n",
    "max_index = max(weights.keys())\n",
    "# Fill in 0 if a key is missing\n",
    "tensor_values = [weights.get(i, 0) for i in range(max_index + 1)]  \n",
    "# Create a tensor from the list\n",
    "wt_tensor = torch.tensor(tensor_values, dtype=torch.float)\n",
    "wt_tensor"
   ]
  },
