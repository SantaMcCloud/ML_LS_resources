   "source": [
    "# so what does this data shows us?\n",
    "print(biogrid[\"Official Symbol Interactor A\"].loc[0:10])\n",
    "print(biogrid[\"Official Symbol Interactor B\"].loc[0:10])\n",
    "\n",
    "# biogrid shows us a network of interacting genes\n"
   ]
